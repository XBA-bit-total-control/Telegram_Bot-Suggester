# Public DNS name pointing to the server's IPv4 address (and IPv6 if configured).
PUBLIC_DOMAIN=your-domain.example
LETSENCRYPT_EMAIL=admin@example.com

# Telegram bot
BOT_TOKEN=replace-with-your-bot-token
BOT_API_SECRET_KEY=replace-with-a-long-random-secret
BOT_MODE=webhook
BOT_WEBHOOK_PATH=/telegram/webhook
BOT_WEBHOOK_SECRET=replace-with-hex-secret

# PostgreSQL
POSTGRES_DB=bot_suggester
POSTGRES_USER=bot_suggester
POSTGRES_PASSWORD=replace-with-url-safe-random-password

# MinIO. Keep these equal to the root credentials used by the MinIO container.
MINIO_ROOT_USER=replace-with-minio-root-user
MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_BUCKET=products
MINIO_SECURE=false

# JWT. Use the algorithm already configured in utilities/jwt_handler.py.
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_LIFE_LENGTH=3600

# Настройки комады получения прав администратора
ADMIN_COMMAND=random_small_English_letters_and_numbers_max_31
ADMIN_BOOTSTRAP_ENABLED=false

# Internal addresses are set by Compose: PostgreSQL=postgres, MinIO=minio:9000,
# Redis=redis:6379, FastAPI=backend:8000. Do not put localhost here.
