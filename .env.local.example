# Локальные переменные для docker-compose.yml + docker-compose.local.yml.
# Скопируйте в .env.local и заполните реальные локальные значения.
# Не коммитьте .env.local в Git.

# PostgreSQL внутри Compose будет доступен backend по адресу postgres:5432.
POSTGRES_DB=bot_suggester_local
POSTGRES_USER=bot_suggester_local
POSTGRES_PASSWORD=local_dev_password_123

# Обязательно укажите действительный токен Telegram-бота,
# если планируете запускать контейнер bot.
BOT_TOKEN=PASTE_REAL_TELEGRAM_BOT_TOKEN_HERE
BOT_API_SECRET_KEY=replace_with_a_long_random_local_secret

# ВАЖНО: ниже укажите ТОЧНО те значения, которые уже используются
# существующим MinIO в вашем .env. Не меняйте их случайно, иначе Compose
# может пересоздать контейнер с другой конфигурацией доступа.
MINIO_ROOT_USER=copy_existing_minio_root_user
MINIO_ROOT_PASSWORD=copy_existing_minio_root_password
MINIO_BUCKET=products
MINIO_SECURE=false

# Для обычного браузера оставьте localhost.
# Для открытия через Telegram Mini App замените на публичный HTTPS URL ngrok,
# например https://your-name.ngrok-free.dev (без завершающего слеша).
FRONTEND_ORIGIN=http://localhost:3000

# Локальный ключ JWT. Для теста замените на собственное случайное значение.
JWT_SECRET_KEY=replace_with_a_long_random_jwt_secret
JWT_ALGORITHM=HS256
JWT_LIFE_LENGTH=3600

# Настройки комады получения прав администратора
ADMIN_COMMAND=random_small_English_letters_and_numbers_max_31
ADMIN_BOOTSTRAP_ENABLED=false
